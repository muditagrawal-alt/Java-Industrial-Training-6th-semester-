Q - Count Binary String without Consecutive One's (GFG)

public class Main
{
    public static int countString(int n) {
        // base ondition
        if(n == 0) return 1;
        if(n == 1) return 2;
        if(n == 2) return 3;
        //logic
        return countString(n-1) + countString(n-2);
    }
	public static void main(String[] args) {
	    int n = 3;
		System.out.println(countString(n));
	}
}

class Solution {

    public static int robFrom(int[] nums, int index) {
        // base condition
        if(index >= nums.length) {
            return 0;
        }
        // logic
        int include = nums[index] + robFrom(nums, index + 2);
        int exclude = robFrom(nums, index + 1);

        return Math.max(include, exclude);
    }

    public int rob(int[] nums) {
        return robFrom(nums, 0);
    }
}

